$C = "../Common.ui";
$T = "TooltipStyle.ui";

Group {
  LayoutMode: Left;
  Button #TakeAllButton { Anchor: (Width: 40, Right: 4); NavOrder: 0; TextTooltipStyle: $T.@ButtonTextTooltipStyle; Style: (Sounds: $C.@ButtonSounds);
    Group { Anchor: (Width: 24, Height: 24); Background: "Textures/TakeAll.png"; }
  }
  Button #PutAllButton { Anchor: (Width: 40); NavOrder: 1; TextTooltipStyle: $T.@ButtonTextTooltipStyle; Style: (Sounds: $C.@ButtonSounds);
    Group { Anchor: (Width: 24, Height: 24); Background: "Textures/PutAll.png"; }
  }
  Button #QuickStackButton { Anchor: (Width: 40, Right: 4); NavOrder: 2; TextTooltipStyle: $T.@ButtonTextTooltipStyle; Style: (Sounds: $C.@ButtonSounds);
    Group { Anchor: (Width: 24, Height: 24); Background: "Textures/QuickStack.png"; }
  }
  Button #BackpackSortButton { Anchor: (Width: 40, Right: 7); NavOrder: 3; TextTooltipStyle: $T.@ButtonTextTooltipStyle; Style: (Sounds: $C.@ButtonSounds);
    Group { Anchor: (Width: 24, Height: 24); Background: "Textures/AutoSortIcon.png"; }
  }
}
