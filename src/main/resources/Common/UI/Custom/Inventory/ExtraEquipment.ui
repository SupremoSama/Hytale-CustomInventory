$C = "../Common.ui";
$G = "InventoryGridStyle.ui";
$T = "TooltipStyle.ui";

@EmptyHat = PatchStyle(TexturePath: "Textures/EquipmentHat.png");
@EmptyBackpack = PatchStyle(TexturePath: "Textures/EquipmentBackpack.png");
@EmptyCollar = PatchStyle(TexturePath: "Textures/EquipmentCollar.png");
@EmptyBelt = PatchStyle(TexturePath: "Textures/EquipmentBelt.png");

// Same frame as the other inventory panels. The host Top (InventoryShell.ui, 231) + title (38)
// + padding (8) puts the grid on PlayerPanel.ui's #ArmorGrid origin (277), so both equipment
// columns share their slot rows.
$C.@Container #ExtraEquipmentPanel {
  @ContentPadding = Padding(Full: 8);
  Anchor: (Left: 0, Top: 0, Width: 98, Height: 362);
  #Title {
    Label #ExtraEquipmentTitle {
      Anchor: (Left: 8, Right: 28);
      Text: %server.custominventory.extraequipment.title;
      Style: (FontName: "Secondary", FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #b4c8c9, HorizontalAlignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 8, LetterSpacing: 0);
    }
  }
  #Content {
    ItemGrid #ExtraEquipmentGrid {
      Anchor: (Left: 2, Width: 78, Height: 308);
      SlotsPerRow: 1;
      InventorySectionId: -1060;
      AreItemsDraggable: true;
      RenderItemQualityBackground: true;
      InfoDisplay: Tooltip;
      Padding: 2;
      Style: $G.@InventoryGridStyle;
    }
  }
}

// One eye per equipment slot, placed like PlayerPanel.ui's armor eyes (grid origin + (54, -4),
// 74 per row). The grid origin is (8 + 2, 38 + 8) in this host. PlayerInventoryPanel shows each
// eye only for an occupied slot, and the whole column only while the panel is expanded.
Group #ExtraEquipmentEyes {
  Anchor: (Left: 64, Top: 42, Width: 32, Height: 254);
  Button #HatVisibility {
    Anchor: (Left: 0, Top: 0, Width: 32, Height: 32);
    TextTooltipStyle: $T.@ButtonTextTooltipStyle;
    Visible: false;
    Group #Visible { HitTestVisible: false; Anchor: (Full: 0); Background: "Textures/ArmorVisibilityOn.png"; }
    Group #Hidden { HitTestVisible: false; Anchor: (Full: 0); Background: "Textures/ArmorVisibilityOff.png"; Visible: false; }
  }
  Button #BackpackVisibility {
    Anchor: (Left: 0, Top: 74, Width: 32, Height: 32);
    TextTooltipStyle: $T.@ButtonTextTooltipStyle;
    Visible: false;
    Group #Visible { HitTestVisible: false; Anchor: (Full: 0); Background: "Textures/ArmorVisibilityOn.png"; }
    Group #Hidden { HitTestVisible: false; Anchor: (Full: 0); Background: "Textures/ArmorVisibilityOff.png"; Visible: false; }
  }
  Button #CollarVisibility {
    Anchor: (Left: 0, Top: 148, Width: 32, Height: 32);
    TextTooltipStyle: $T.@ButtonTextTooltipStyle;
    Visible: false;
    Group #Visible { HitTestVisible: false; Anchor: (Full: 0); Background: "Textures/ArmorVisibilityOn.png"; }
    Group #Hidden { HitTestVisible: false; Anchor: (Full: 0); Background: "Textures/ArmorVisibilityOff.png"; Visible: false; }
  }
  Button #BeltVisibility {
    Anchor: (Left: 0, Top: 222, Width: 32, Height: 32);
    TextTooltipStyle: $T.@ButtonTextTooltipStyle;
    Visible: false;
    Group #Visible { HitTestVisible: false; Anchor: (Full: 0); Background: "Textures/ArmorVisibilityOn.png"; }
    Group #Hidden { HitTestVisible: false; Anchor: (Full: 0); Background: "Textures/ArmorVisibilityOff.png"; Visible: false; }
  }
}

// Expanded: a header action. Collapsed: a pull-tab beside the player panel (PlayerInventoryPanel sets the Anchor).
Button #ExtraEquipmentToggle {
  Anchor: (Left: 70, Top: 8, Width: 24, Height: 24);
  NavOrder: 0;
  TooltipText: %server.custominventory.extraequipment.hide;
  TextTooltipStyle: $T.@ButtonTextTooltipStyle;
  Style: ButtonStyle(
    Default: (),
    Hovered: (Background: #ffffff(0.08)),
    Pressed: (Background: #ffffff(0.14)),
    Sounds: $C.@ButtonSounds
  );
  Group #TabBackground { Anchor: (Full: 0); Background: (TexturePath: "../Common/ContainerFullPatch.png", Border: 10); Visible: false; HitTestVisible: false; }
  Group #CollapseIcon { Anchor: (Width: 14, Height: 14); Background: "Textures/EquipmentCollapseArrow.png"; HitTestVisible: false; }
  Group #ExpandIcon { Anchor: (Width: 14, Height: 14); Background: "Textures/EquipmentExpandArrow.png"; HitTestVisible: false; Visible: false; }
}
