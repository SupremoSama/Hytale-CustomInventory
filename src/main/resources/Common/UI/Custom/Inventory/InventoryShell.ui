$C = "../Common.ui";

@PanelTitleStyle = LabelStyle(FontSize: 15, RenderBold: true, RenderUppercase: true, TextColor: #b4c8c9, FontName: "Secondary", LetterSpacing: 0, HorizontalAlignment: Start, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
@MemoriesPanelTitleStyle = LabelStyle(...@PanelTitleStyle, FontName: "Default", LetterSpacing: 0.5);
@CraftingContentPadding = Padding(Full: 12);
@BackpackContentPadding = Padding(Full: 15);
@ScrollableBackpackContentPadding = Padding(Full: 15, Right: 4);
@MemoriesContentPadding = Padding(Full: 0);

SceneBlur {}
Group { Background: #000000(0.55); }

// Behind the panels: only drops onto the exposed backdrop reach this empty slot.
Group #InventoryBackdrop {
  Anchor: (Full: 0);
  // The backdrop is a mouse drop surface, not an inventory navigation section.
  NavExclude: true;
  ItemGrid #InventoryDropZone {
    Anchor: (Full: 0);
    SlotsPerRow: 1;
    AreItemsDraggable: false;
    RenderItemQualityBackground: false;
    Padding: 0;
    Style: (SlotSize: 4096, SlotIconSize: 1, SlotSpacing: 0, SlotBackground: "Utility/Textures/TransparentSlot.png");
  }
}

// InventoryPage.ui and InGame/Common.ui: 715 + 410*2 + 38*2.
Group #InventoryShell {
  Anchor: (Width: 1721, Top: 0, Bottom: 20);
  LayoutMode: Left;
  // ExtraEquipment.ui aligns its grid with the armor grid from this origin.
  Group #ExtraEquipmentHost { Anchor: (Width: 110, Height: 362, Top: 231); }
  Group #PlayerPanelHost {
    Anchor: (Width: 410, Height: 720, Top: 180);
    LayoutMode: Top;
  }
  Group #CenterColumn {
    Anchor: (Horizontal: 38, Width: 715);
    LayoutMode: Bottom;
    $C.@Container #ContentPanel {
      Anchor: (Height: 423);
      #Title {
        LayoutMode: Left;
        Label #PageTitle { FlexWeight: 1; Padding: (Horizontal: 19); Style: @PanelTitleStyle; }
        Group #PageHeaderActions { LayoutMode: Left; }
        Group #HeaderExtensions { LayoutMode: Left; }
      }
      #Content {
        LayoutMode: Top;
        Padding: (Full: 12);
        Group #ContentHost { FlexWeight: 1; LayoutMode: Top; }
        Group #ContentExtensions { Anchor: (Full: 0); }
      }
    }
    Group #InventoryPanelHost { Anchor: (Height: 452, Top: 8); LayoutMode: Top; }
  }
  Group #AuxiliaryRegion {
    Anchor: (Width: 410);
    Group #AuxiliaryHost { Anchor: (Left: 0, Right: 0, Top: 180); LayoutMode: Top; }
    Group #AuxiliaryExtensions { Anchor: (Left: 0, Right: 0, Top: 180); }
  }
}

Group #ShellActions {
  Visible: false;
  TextButton #CloseButton {}
  TextButton #RefreshButton {}
}
