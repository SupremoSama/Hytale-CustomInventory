$C = "../../Common.ui";
$T = "../TooltipStyle.ui";
$G = "../InventoryGridStyle.ui";

@ChoiceStyle = ItemGridStyle(
  SlotSize: 64,
  SlotIconSize: 56,
  SlotSpacing: 0,
  DefaultItemIcon: "../Textures/UnknownItemIcon.png",
  QuantityPopupSlotOverlay: "../Textures/QuantityPopupSlotOverlay.png"
);

@CenterStyle = ItemGridStyle(
  ...$G.@UtilityGridStyle
);

@CenterCompatibleStyle = ItemGridStyle(
  ...$G.@InventoryGridStyle,
  SlotBackground: "Textures/SpecialSlotCompatible.png"
);

@Choice = ItemGrid {
  Anchor: (Width: 64, Height: 64);
  SlotsPerRow: 1;
  InventorySectionId: -5;
  AreItemsDraggable: true;
  RenderItemQualityBackground: false;
  RenderEmptySlots: false;
  MaskTexturePath: "Textures/TransparentSlot.png";
  Background: #000000(0);
  Padding: 0;
  Style: @ChoiceStyle;
};

// ItemGrid paints its own rectangular mouse highlight. Keep its native drag
// surface under a render mask, then render the same slots in a display-only
// grid so the wheel's native wedge is the only visible hover effect.
@ChoiceMask = Group {
  Anchor: (Width: 64, Height: 64);
  MaskTexturePath: "Textures/TransparentSlot.png";
};

@ChoiceDisplay = Group {
  Anchor: (Width: 64, Height: 64);
  HitTestVisible: false;
  ItemIcon #ItemVisual {
    Anchor: (Full: 4);
    ShowItemTooltip: false;
    HitTestVisible: false;
    Visible: false;
  }
  Label #Quantity {
    Anchor: (Right: 0, Bottom: 0, Width: 32, Height: 22);
    Style: (FontSize: 16, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: End, VerticalAlignment: End);
    HitTestVisible: false;
    Visible: false;
  }
};

Button #UtilityWheel {
  Anchor: (Full: 0);
  Background: #000000(0);
  Style: (Default: (), Hovered: (), Pressed: ());
  // The native wheel dims the special slot, pointer and binding beneath its
  // translucent center. Decorative layers preserve the center's drop target.
  Group #UtilityCenterPointer {
    Anchor: (Left: 116, Top: 59, Width: 79, Height: 136);
    Background: "Textures/SpecialSlotPointer.png";
    Visible: false;
    HitTestVisible: false;
  }
  ItemGrid #UtilityWheelCenterGrid {
    Anchor: (Left: 117, Top: 116, Width: 76, Height: 78);
    SlotsPerRow: 1;
    InventorySectionId: -5;
    AreItemsDraggable: true;
    RenderItemQualityBackground: true;
    Background: #000000(0);
    Padding: 2;
    Style: @CenterStyle;
  }
  Label #UtilityWheelInputBinding {
    Anchor: (Left: 139, Top: 180, Width: 32, Height: 24);
    Background: (TexturePath: "../Textures/SlotInputBindingBackground.png", Border: 4);
    Padding: (Top: 1);
    Style: (RenderBold: true, Alignment: Center, TextColor: #ffffe6, FontName: "Secondary", FontSize: 12);
    Text: "Z";
    HitTestVisible: false;
  }
  Group #UtilityWheelOverlay { Anchor: (Full: 0); Background: "Textures/ItemSlotSelectorBackground.png"; HitTestVisible: false; }
  // Native choices run clockwise starting from Bottom-Left, leaving the
  // bottom slice for unequip:
  // Slot 0 = Bottom-Left, Slot 1 = Top-Left, Slot 2 = Top-Right, Slot 3 = Bottom-Right.
  Group #UtilitySelected0 { Anchor: (Full: 0); Background: "Textures/ItemSlotSelectorSelected2.png"; Visible: false; HitTestVisible: false; }
  Group #UtilitySelected1 { Anchor: (Full: 0); Background: "Textures/ItemSlotSelectorSelected3.png"; Visible: false; HitTestVisible: false; }
  Group #UtilitySelected2 { Anchor: (Full: 0); Background: "Textures/ItemSlotSelectorSelected0.png"; Visible: false; HitTestVisible: false; }
  Group #UtilitySelected3 { Anchor: (Full: 0); Background: "Textures/ItemSlotSelectorSelected1.png"; Visible: false; HitTestVisible: false; }
  Group #UtilitySelectedClear { Anchor: (Full: 0); Background: "Textures/ItemSlotSelectorSelectedClear.png"; Visible: false; HitTestVisible: false; }
  Group #UtilityHovered0 { Anchor: (Full: 0); Background: "Textures/ItemSlotSelectorHovered1.png"; Visible: false; HitTestVisible: false; }
  Group #UtilityHovered1 { Anchor: (Full: 0); Background: "Textures/ItemSlotSelectorHovered0.png"; Visible: false; HitTestVisible: false; }
  Group #UtilityHovered2 { Anchor: (Full: 0); Background: "Textures/ItemSlotSelectorHovered3.png"; Visible: false; HitTestVisible: false; }
  Group #UtilityHovered3 { Anchor: (Full: 0); Background: "Textures/ItemSlotSelectorHovered2.png"; Visible: false; HitTestVisible: false; }
  Group #UtilityHoveredClear { Anchor: (Full: 0); Background: "Textures/ItemSlotSelectorHoveredClear.png"; Visible: false; HitTestVisible: false; }
  @ChoiceMask #UtilityChoiceMask0 { Anchor: (Left: 20, Top: 156, Width: 64, Height: 64); @Choice #UtilityChoiceGrid0 {} }
  @ChoiceMask #UtilityChoiceMask1 { Anchor: (Left: 60, Top: 36, Width: 64, Height: 64); @Choice #UtilityChoiceGrid1 {} }
  @ChoiceMask #UtilityChoiceMask2 { Anchor: (Left: 187, Top: 36, Width: 64, Height: 64); @Choice #UtilityChoiceGrid2 {} }
  @ChoiceMask #UtilityChoiceMask3 { Anchor: (Left: 226, Top: 156, Width: 64, Height: 64); @Choice #UtilityChoiceGrid3 {} }
  @ChoiceDisplay #UtilityChoiceDisplay0 { Anchor: (Left: 20, Top: 156, Width: 64, Height: 64); }
  @ChoiceDisplay #UtilityChoiceDisplay1 { Anchor: (Left: 60, Top: 36, Width: 64, Height: 64); }
  @ChoiceDisplay #UtilityChoiceDisplay2 { Anchor: (Left: 187, Top: 36, Width: 64, Height: 64); }
  @ChoiceDisplay #UtilityChoiceDisplay3 { Anchor: (Left: 226, Top: 156, Width: 64, Height: 64); }
  Button #UtilityClear {
    Anchor: (Left: 123, Top: 231, Width: 64, Height: 64);
    TextTooltipStyle: $T.@ButtonTextTooltipStyle;
    Style: (Default: (), Hovered: (), Pressed: (), Sounds: $C.@ButtonSounds);
    Group { Anchor: (Left: 16, Top: 16, Width: 33, Height: 33); Background: "Textures/ItemSlotSelectorEmptyIcon.png"; HitTestVisible: false; }
  }
}
